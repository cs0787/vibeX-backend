PORT=8787
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Neon Postgres connection string. Copy this from Neon Dashboard → Connection Details.
# With DATABASE_URL set, sessions, evidence and reports persist in Neon.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Use a unique, random 32+ character value. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# NVIDIA NIM (server-side only — never expose this value in the React app).
# Create an API key at https://build.nvidia.com/ and choose an available chat model.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
